<?xml version="1.0" encoding="utf-8"?>
                                                                   
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/common_8dp"
        android:background="@color/transparent" android:tag="layout/popup_window_text_0" xmlns:android="http://schemas.android.com/apk/res/android">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_popup">

            <TextView
                android:id="@+id/popup_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more_info_sensitivity_pocket"
                android:textSize="@dimen/text_size_13sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppinsregular"
                android:paddingHorizontal="@dimen/common_8dp"
                android:paddingVertical="@dimen/common_12dp" />
        </LinearLayout>
    </FrameLayout>
         